\deqn{ D = 1 - \frac{\sum (n_i^2 - n_i)}{N^2 - N} }{
     D = 1 - sum(n_i^2 - n_i) / (N^2 - N) }
where \eqn{n_i} is the number of samples of pathotype \eqn{i} and
#' where \eqn{N} is the total number of samples and \eqn{n_i} is the
